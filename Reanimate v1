local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")

if getgenv().LimbReanim == true then return end
getgenv().LimbReanim = true

local plr = Players.LocalPlayer
local chr = plr.Character or plr.CharacterAdded:Wait()
local hrp = chr:WaitForChild("HumanoidRootPart")
local hum = chr:WaitForChild("Humanoid")

hum.BreakJointsOnDeath = false; hum.MaxHealth = math.huge; hum.Health = math.huge
pcall(function() local a = chr:FindFirstChild("Animate"); if a then a:Destroy() end end)
pcall(function()
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:Stop() end
		animator:Destroy()
	end
end)

local motors = {}; local sine = 0; local scale = chr:GetScale()

local function setup()
	table.clear(motors)
	for _, v in ipairs(chr:GetDescendants()) do
		if v:IsA("Motor6D") and v.Part0 and v.Part1 and v.Name ~= "RightGrip" then
			table.insert(motors, {motor=v, c0=v.C0, c1=v.C1, name=v.Name})
		end
	end
end

-- keep motor6ds enabled, drive Transform (replicates on good executors)
RunService.Stepped:Connect(function()
	settings().Physics.AllowSleep=false; plr.SimulationRadius=2147483647
	if sethiddenproperty then pcall(function() sethiddenproperty(plr,"MaximumSimulationRadius",math.huge); plr.ReplicationFocus=chr end) end
end)

RunService.PostSimulation:Connect(function(dt)
	if not getgenv().LimbReanim then return end
	sine = sine + dt
	for i, e in ipairs(motors) do
		local m = e.motor
		if not m or not m.Parent then continue end
		local ph = (i / #motors) * math.pi * 2
		local off = CFrame.new(
			math.sin(sine*0.7+ph)*0.5, math.sin(sine*0.9+ph+0.5)*0.5, math.cos(sine*1.1+ph+1)*0.5
		) * CFrame.Angles(
			math.sin(sine*1.3+ph*0.5)*0.3, math.sin(sine*1.1+ph*0.3)*0.4, math.sin(sine*0.8+ph*0.7)*0.25
		)
		local t = e.c0:Inverse() * off * e.c1
		t = t.Rotation + t.Position * scale
		local p = t.Position
		if p.X==p.X and p.Y==p.Y and p.Z==p.Z then m.Transform = t end
	end
end)

pcall(function() setup() end)

plr.CharacterAdded:Connect(function()
	getgenv().LimbReanim=false
	for _,e in ipairs(motors) do if e.motor and e.motor.Parent then e.motor.Transform=CFrame.identity end end
	table.clear(motors)
end)
